# Flux Configuration
# This is an example configuration file.
# Copy this to ~/.config/flux/config.toml and customize as needed.
#
# For editor autocomplete and validation, use the JSON schema:
# schemas/config.schema.json
# See schemas/README.md for setup instructions.
#:schema https://github.com/Chrono-byte/dotfiles-manager/raw/refs/heads/master/schemas/config.schema.json
[general]
# Repository path where dotfiles are stored
repo_path = "~/.dotfiles"

# Current active profile
current_profile = "default"

# Directory for backups (created automatically on conflicts)
backup_dir = "~/.dotfiles-backups"

# Symlink resolution strategy: auto, relative, absolute, follow, replace
# - auto: Use relative if possible, absolute if needed (recommended)
# - relative: Always create relative symlinks
# - absolute: Always create absolute symlinks
# - follow: Follow existing symlinks, replace target
# - replace: Replace symlinks with actual files (copy)
symlink_resolution = "auto"

# Default remote for push operations (optional, defaults to "origin")
# default_remote = "origin"

# Default branch for push operations (optional, defaults to "main" if no HEAD)
# default_branch = "main"

# Tool configurations
# Each tool section defines files to track
# Files can have profile-specific overrides

[tools.sway]
# Sway window manager configuration
files = [
    { repo = "config", dest = ".config/sway/config" },
    # Profile-specific override example:
    # { repo = "config.work", dest = ".config/sway/config", profile = "work" }
]

[tools.waybar]
# Waybar status bar configuration
files = [
    { repo = "config", dest = ".config/waybar/config" },
    { repo = "style.css", dest = ".config/waybar/style.css" }
]

[tools.cursor]
# Cursor editor settings
files = [
    { repo = "settings.json", dest = ".config/Cursor/User/settings.json" },
    { repo = "keybindings.json", dest = ".config/Cursor/User/keybindings.json" }
]

[tools.vscode]
# VS Code settings (if using both editors)
files = [
    { repo = "settings.json", dest = ".config/Code/User/settings.json" }
]

[tools.mako]
# Mako notification daemon
files = [
    { repo = "config", dest = ".config/mako/config" }
]

[tools.rofi]
# Rofi application launcher
files = [
    { repo = "config.rasi", dest = ".config/rofi/config.rasi" }
]

[tools.firefox]
# Firefox browser settings
# Use 'flux add-browser firefox' to auto-detect and add
# Example manual entry:
# files = [
#     { repo = "prefs.js", dest = ".mozilla/firefox/xxxxx.default/prefs.js" },
#     { repo = "extensions", dest = ".mozilla/firefox/xxxxx.default/extensions" }
# ]

[tools.zen]
# Zen browser settings
# Use 'flux add-browser zen' to auto-detect and add
# Example manual entry:
# files = [
#     { repo = "prefs.js", dest = ".zenbrowser/profiles/default/prefs.js" },
#     { repo = "extensions", dest = ".zenbrowser/profiles/default/extensions" }
# ]

[tools.alacritty]
# Alacritty terminal emulator configuration
# Use 'flux add-browser alacritty' to auto-detect and add
# Example manual entry:
# files = [
#     { repo = "alacritty.toml", dest = ".config/alacritty/alacritty.toml" },
#     # Or for YAML format:
#     # { repo = "alacritty.yml", dest = ".config/alacritty/alacritty.yml" }
# ]

[tools.starship]
# Starship prompt configuration
# Use 'flux add-browser starship' to auto-detect and add
# Example manual entry:
# files = [
#     { repo = "starship.toml", dest = ".config/starship.toml" }
# ]

# Custom tools can be added with any name
# [tools.my_custom_tool]
# files = [
#     { repo = "custom.conf", dest = ".config/custom/custom.conf" }
# ]

# ============================================================
# CONDITIONAL FILE LOADING
# ============================================================
# Files can be conditionally loaded based on system properties.
# All conditions within a group must match (AND logic).
# Multiple groups can be used for more complex logic.

# Example: OS-specific files
# [tools.shell]
# files = [
#     # Linux-specific shell config
#     {
#         repo = "bashrc.linux",
#         dest = ".bashrc",
#         conditions = { groups = [
#             { conditions = [
#                 { type = "os", value = "linux" }
#             ]}
#         ]}
#     },
#     # macOS-specific shell config (darwin is an alias for macos)
#     {
#         repo = "bashrc.macos",
#         dest = ".bashrc",
#         conditions = { groups = [
#             { conditions = [
#                 { type = "os", value = "darwin" }
#             ]}
#         ]}
#     }
# ]

# Example: Host-specific files
# [tools.work]
# files = [
#     # Only load on work laptop
#     {
#         repo = "work-settings.json",
#         dest = ".config/work/settings.json",
#         conditions = { groups = [
#             { conditions = [
#                 { type = "host", value = "work-laptop" }
#             ]}
#         ]}
#     }
# ]

# Example: Environment variable conditions
# [tools.x11]
# files = [
#     # Only load when running X11
#     {
#         repo = "xinitrc",
#         dest = ".xinitrc",
#         conditions = { groups = [
#             { conditions = [
#                 { type = "env_var_exists", name = "DISPLAY" }
#             ]}
#         ]}
#     }
# ]

# Example: Command existence checks
# [tools.docker]
# files = [
#     # Only load Docker config if Docker is installed
#     {
#         repo = "docker-config.json",
#         dest = ".docker/config.json",
#         conditions = { groups = [
#             { conditions = [
#                 { type = "command_exists", command = "docker" }
#             ]}
#         ]}
#     }
# ]

# Example: Architecture-specific files
# [tools.native]
# files = [
#     # ARM64 specific config
#     {
#         repo = "config.arm64",
#         dest = ".config/app/config",
#         conditions = { groups = [
#             { conditions = [
#                 { type = "architecture", value = "aarch64" }
#             ]}
#         ]}
#     },
#     # x86_64 specific config
#     {
#         repo = "config.x86",
#         dest = ".config/app/config",
#         conditions = { groups = [
#             { conditions = [
#                 { type = "architecture", value = "x86_64" }
#             ]}
#         ]}
#     }
# ]

# Example: Multiple conditions (all must match)
# [tools.dev]
# files = [
#     # Only on Linux work laptop with Docker installed
#     {
#         repo = "dev-environment.sh",
#         dest = ".config/dev/environment.sh",
#         conditions = { groups = [
#             { conditions = [
#                 { type = "os", value = "linux" },
#                 { type = "host", value = "work-laptop" },
#                 { type = "command_exists", command = "docker" }
#             ]}
#         ]}
#     }
# ]

# All available condition types:
# - os: Operating system (linux, macos/darwin, windows, etc.)
# - host: Hostname
# - env_var: Environment variable with specific value
# - env_var_exists: Environment variable is set (any value)
# - command_exists: Command is available in PATH
# - file_exists: File or directory exists (supports ~ and $VAR expansion)
# - architecture: CPU architecture (x86_64, aarch64, arm, etc.)
# - shell: Current shell (bash, zsh, fish, etc.)
# - user: Current username
# - group: User is in specific group (Unix only)

# ============================================================
